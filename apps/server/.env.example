# PostgreSQL connection string used by Drizzle and the API.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/flowpay

# Better Auth requires a strong secret with at least 32 characters.
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-32-characters

# Public base URL where the API is available during development.
BETTER_AUTH_URL=http://localhost:3000

# Origin allowed to call the API from the native development client.
CORS_ORIGIN=http://localhost:8081

# Runtime mode used by server error handling and auth configuration.
NODE_ENV=development
