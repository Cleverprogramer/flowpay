{
  "name": "server",
  "type": "module",
  "main": "src/index.ts",
  "scripts": {
    "build": "tsdown",
    "check-types": "tsc -b",
    "compile": "bun build --compile --minify --sourcemap --bytecode ./src/index.ts --outfile server",
    "dev": "bun run --hot src/index.ts",
    "test": "bun test",
    "start": "bun run dist/index.mjs"
  },
  "dependencies": {
    "@flowpay/auth": "workspace:*",
    "@flowpay/db": "workspace:*",
    "@flowpay/env": "workspace:*",
    "@flowpay/schema": "workspace:*",
    "@hono/zod-validator": "^0.7.6",
    "better-auth": "catalog:",
    "dotenv": "catalog:",
    "hono": "^4.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@flowpay/config": "workspace:*",
    "@types/bun": "catalog:",
    "tsdown": "^0.16.5",
    "typescript": "catalog:"
  },
  "trustedDependencies": [
    "supabase"
  ]
}
